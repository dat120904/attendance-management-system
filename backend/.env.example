PORT=4000
FRONTEND_URL=http://localhost:5173
# IANA timezone used for work dates, schedules, late/early status, and overtime.
APP_TIME_ZONE=Asia/Ho_Chi_Minh
# For multiple frontend domains, use comma-separated origins:
# ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/workforce_pro?schema=public"

# SMTP used for real password-reset emails.
# Gmail: host smtp.gmail.com, port 465, secure true, and use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="Workforce Pro <your-email@gmail.com>"